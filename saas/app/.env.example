# Copier en .env.local (jamais versionné). Aucune valeur secrète dans ce fichier.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Projet > Settings > API). La clé "service_role" ne doit JAMAIS être exposée au navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (mode test d'abord : clés sk_test_… / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix créés dans Stripe (Produits > Prix), un par offre et par période
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=
STRIPE_PRICE_PREMIUM_MENSUEL=
STRIPE_PRICE_PREMIUM_ANNUEL=
STRIPE_PRICE_ULTRA_MENSUEL=
STRIPE_PRICE_ULTRA_ANNUEL=

# Anthropic (IA côté serveur uniquement)
ANTHROPIC_API_KEY=

# Contact affiché dans les pages légales et les e-mails
CONTACT_EMAIL=
