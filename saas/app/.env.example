# Copier en .env.local (jamais versionné). Aucune valeur secrète dans ce fichier.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sites publiés en un clic : domaine racine des sous-domaines (ex. mysite.site → pizza-bella.mysite.site).
# Vide = adresses de secours en /s/<adresse> sur le domaine de l'application. Ajoutez *.<domaine> au projet Vercel.
NEXT_PUBLIC_DOMAINE_SITES=
# Branchement automatique des domaines des clients (facultatif ; sinon ajout manuel dans Vercel > Domains)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Hébergeur affiché dans les mentions légales des sites publiés (à vérifier, avec son téléphone)
HEBERGEUR_NOM=Vercel Inc.
HEBERGEUR_ADRESSE=440 N Barranca Ave #4133, Covina, CA 91723, États-Unis
HEBERGEUR_TELEPHONE=

# Fond de carte (Leaflet). Les tuiles OpenStreetMap sont réservées à un usage modéré : en production,
# prenez un fournisseur (MapTiler, Stadia, IGN Géoplateforme…) et indiquez son URL et son attribution.
NEXT_PUBLIC_TUILES_URL=
NEXT_PUBLIC_TUILES_ATTRIBUTION=

# Supabase (Projet > Settings > API). La clé "service_role" ne doit JAMAIS être exposée au navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (mode test d'abord : clés sk_test_… / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix créés dans Stripe (Produits > Prix), un par offre et par période
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=
STRIPE_PRICE_PREMIUM_MENSUEL=
STRIPE_PRICE_PREMIUM_ANNUEL=
STRIPE_PRICE_ULTRA_MENSUEL=
STRIPE_PRICE_ULTRA_ANNUEL=

# Anthropic (IA côté serveur uniquement)
ANTHROPIC_API_KEY=

# Contact affiché dans les pages légales et les e-mails
CONTACT_EMAIL=
